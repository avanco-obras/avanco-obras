generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ENGINEER
  FOREMAN
  VIEWER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
}

enum MeasurementMethod {
  PERCENT
  METRIC
  COUNT
}

enum WeeklyProgramStatus {
  RASCUNHO
  PUBLICADA
  FECHADA
}

enum WeeklyActivityStatus {
  PROGRAMADA
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  REPROGRAMADA
}

enum WeeklyActivityOrigin {
  CRONOGRAMA
  MANUAL
  REPROGRAMADA
}

enum WeeklyRestrictionStatus {
  PENDENTE
  RESOLVIDA
}

enum WeeklySnapshotKind {
  PUBLICACAO
  REPORT
  FECHAMENTO
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         UserRole  @default(VIEWER)
  phone        String?
  crea         String?
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  notificationPreferences Json? @map("notification_preferences")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projectMembers ProjectMember[]
  measurements   Measurement[]
  weeklySnapshots WeeklySnapshot[]
  baselines      ProjectBaseline[]
  reports        ProjectReport[] @relation("ReportUser")
  revisions      ScheduleRevision[] @relation("RevisionUser")

  @@map("users")
}

model Project {
  id               String        @id @default(uuid())
  name             String
  company          String
  address          String
  engineer         String?
  contact          String?
  status           ProjectStatus @default(PLANNING)
  startDate        DateTime      @map("start_date")
  endDate          DateTime      @map("end_date")
  estimatedCost    Decimal?      @map("estimated_cost") @db.Decimal(15, 2)
  currency         String        @default("BRL")
  totalArea        Decimal?      @map("total_area") @db.Decimal(12, 2)
  workdaysPerWeek  Int           @default(5) @map("workdays_per_week")
  hoursPerDay      Int           @default(8) @map("hours_per_day")
  weekStartDay     Int           @default(1) @map("week_start_day") // 0=Domingo … 6=Sábado
  timezone         String        @default("America/Sao_Paulo")
  progressCriteria String        @default("COST") @map("progress_criteria")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  members          ProjectMember[]
  towers           Tower[]
  scheduleItems    ScheduleItem[]
  weeklyPrograms   WeeklyProgram[]
  contractors      Contractor[]
  restrictionTypes RestrictionType[]
  uploads          Upload[]
  activityTypes    ActivityType[]
  baselines        ProjectBaseline[]
  reports          ProjectReport[]
  revisions        ScheduleRevision[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      UserRole @default(VIEWER)
  addedAt   DateTime @default(now()) @map("added_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Tower {
  id        String @id @default(uuid())
  projectId String @map("project_id")
  name      String
  order     Int    @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floors  Floor[]

  @@map("towers")
}

model Floor {
  id      String @id @default(uuid())
  towerId String @map("tower_id")
  name    String
  level   Int
  order   Int    @default(0)

  tower Tower    @relation(fields: [towerId], references: [id], onDelete: Cascade)
  units Unit[]
  plans Upload[]

  @@map("floors")
}

model Unit {
  id       String   @id @default(uuid())
  floorId  String   @map("floor_id")
  name     String
  area     Decimal? @db.Decimal(10, 2)
  order    Int      @default(0)

  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  measurements Measurement[]

  @@map("units")
}

model ActivityType {
  id                String            @id @default(uuid())
  projectId         String            @map("project_id")
  name              String
  measurementMethod MeasurementMethod @default(PERCENT) @map("measurement_method")
  unit              String            @default("%")
  defaultQuantity   Decimal           @default(0) @map("default_quantity") @db.Decimal(12, 2)
  weight            Decimal           @default(1) @db.Decimal(8, 4)
  order             Int               @default(0)

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  measurements  Measurement[]
  scheduleItems ScheduleItem[]

  @@unique([projectId, name])
  @@map("activity_types")
}

model ScheduleItem {
  id              String    @id @default(uuid())
  projectId       String    @map("project_id")
  parentId        String?   @map("parent_id")
  activityTypeId  String?   @map("activity_type_id")
  code            String
  name            String
  level           Int       @default(0)
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  durationDays    Int       @map("duration_days")
  plannedProgress  Decimal  @default(0) @map("planned_progress") @db.Decimal(5, 2)
  physicalProgress Decimal  @default(0) @map("physical_progress") @db.Decimal(5, 2)
  weight          Decimal   @default(1) @db.Decimal(8, 4)
  isCriticalPath  Boolean   @default(false) @map("is_critical_path")
  order           Int       @default(0)
  responsible     String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       ScheduleItem? @relation("ScheduleHierarchy", fields: [parentId], references: [id])
  children     ScheduleItem[] @relation("ScheduleHierarchy")
  activityType ActivityType? @relation(fields: [activityTypeId], references: [id])

  predecessors ScheduleDependency[] @relation("SuccessorDep")
  successors   ScheduleDependency[] @relation("PredecessorDep")
  weeklyActivities WeeklyActivity[]

  @@index([projectId, code])
  @@index([projectId, parentId])
  @@map("schedule_items")
}

model ScheduleDependency {
  id            String @id @default(uuid())
  predecessorId String @map("predecessor_id")
  successorId   String @map("successor_id")
  lagDays       Int    @default(0) @map("lag_days")
  type          String @default("FS")

  predecessor ScheduleItem @relation("PredecessorDep", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   ScheduleItem @relation("SuccessorDep", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@map("schedule_dependencies")
}

model ProjectBaseline {
  id                    String   @id @default(uuid())
  projectId             String   @map("project_id")
  version               Int      @default(1)
  createdAt             DateTime @default(now()) @map("created_at")
  userId                String   @map("user_id")
  scheduleSnapshot      Json     @map("schedule_snapshot") // Array of ScheduleItem snapshot
  dependencySnapshot    Json?    @map("dependency_snapshot") // Array of ScheduleDependency snapshot
  description           String?  // Optional description for the baseline

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id])
  reports ProjectReport[]

  @@unique([projectId, version])
  @@index([projectId, createdAt])
  @@map("project_baselines")
}

model ProjectReport {
  id                    String   @id @default(uuid())
  projectId             String   @map("project_id")
  baselineId            String?  @map("baseline_id")
  reportNumber          Int      @default(1) @map("report_number")
  createdAt             DateTime @default(now()) @map("created_at")
  userId                String   @map("user_id")
  physicalProgress      Decimal  @default(0) @map("physical_progress") @db.Decimal(5, 2)
  scheduleSnapshot      Json     @map("schedule_snapshot") // Array of ScheduleItem snapshot with progress
  dependencySnapshot    Json?    @map("dependency_snapshot") // Array of ScheduleDependency (só em snapshotVersion 2)
  measurementSnapshot   Json?    @map("measurement_snapshot") // Array of Measurement (só em snapshotVersion 2)
  /// 1 = só cronograma (reports gravados antes da restauração existir).
  /// 2 = snapshot completo, restaurável por inteiro.
  snapshotVersion       Int      @default(1) @map("snapshot_version")
  comparisonData        Json?    @map("comparison_data") // Comparison with baseline
  description           String?

  project  Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseline ProjectBaseline?  @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  user     User              @relation("ReportUser", fields: [userId], references: [id])

  @@unique([projectId, reportNumber])
  @@index([projectId, createdAt])
  @@map("project_reports")
}

model ScheduleRevision {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  description String?
  changes     Json // [{ itemId, code, name, before:{startDate,endDate,durationDays}, after:{...} }]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("RevisionUser", fields: [userId], references: [id])

  @@index([projectId, createdAt])
  @@map("schedule_revisions")
}

model Measurement {
  id              String   @id @default(uuid())
  unitId          String   @map("unit_id")
  activityTypeId  String   @map("activity_type_id")
  measuredById    String   @map("measured_by_id")
  date            DateTime @default(now())
  percentComplete Decimal  @default(0) @map("percent_complete") @db.Decimal(5, 2)
  executedQty     Decimal? @map("executed_qty") @db.Decimal(12, 2)
  totalQty        Decimal? @map("total_qty") @db.Decimal(12, 2)
  notes           String?
  photoUrl        String?  @map("photo_url")
  createdAt       DateTime @default(now()) @map("created_at")

  unit         Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  activityType ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Cascade)
  measuredBy   User         @relation(fields: [measuredById], references: [id])

  @@index([unitId, activityTypeId])
  @@index([date])
  @@map("measurements")
}

model Contractor {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities WeeklyActivity[]

  @@unique([projectId, name])
  @@map("contractors")
}

model RestrictionType {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  name      String
  order     Int     @default(0)
  isActive  Boolean @default(true) @map("is_active")

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  restrictions WeeklyRestriction[]

  @@unique([projectId, name])
  @@map("restriction_types")
}

model WeeklyProgram {
  id          String              @id @default(uuid())
  projectId   String              @map("project_id")
  weekNumber  Int                 @map("week_number")
  year        Int
  startDate   DateTime            @map("start_date")
  endDate     DateTime            @map("end_date")
  meetingDate DateTime            @map("meeting_date")
  status      WeeklyProgramStatus @default(RASCUNHO)
  publishedAt DateTime?           @map("published_at")
  closedAt    DateTime?           @map("closed_at")
  indicators  Json?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities   WeeklyActivity[]
  restrictions WeeklyRestriction[]
  snapshots    WeeklySnapshot[]

  @@unique([projectId, year, weekNumber])
  @@index([projectId, startDate])
  @@map("weekly_programs")
}

model WeeklyActivity {
  id              String               @id @default(uuid())
  programId       String               @map("program_id")
  scheduleItemId  String?              @map("schedule_item_id")
  origin          WeeklyActivityOrigin @default(MANUAL)
  local           String               @default("")
  torre           String               @default("")
  pavimento       String               @default("")
  activityName    String               @map("activity_name")
  contractorId    String?              @map("contractor_id")
  responsible     String?
  status          WeeklyActivityStatus @default(PROGRAMADA)
  percentExecuted Int                  @default(0) @map("percent_executed")
  carryoverFromId String?              @map("carryover_from_id")
  order           Int                  @default(0)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  program          WeeklyProgram               @relation(fields: [programId], references: [id], onDelete: Cascade)
  scheduleItem     ScheduleItem?               @relation(fields: [scheduleItemId], references: [id], onDelete: SetNull)
  contractor       Contractor?                 @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  carryoverFrom    WeeklyActivity?             @relation("Carryover", fields: [carryoverFromId], references: [id], onDelete: SetNull)
  carryoverTo      WeeklyActivity[]            @relation("Carryover")
  restrictionLinks WeeklyRestrictionActivity[]

  @@index([programId])
  @@index([scheduleItemId])
  @@map("weekly_activities")
}

model WeeklyRestriction {
  id             String                  @id @default(uuid())
  programId      String                  @map("program_id")
  typeId         String?                 @map("type_id")
  description    String
  responsible    String
  dueDate        DateTime?               @map("due_date")
  resolvedAt     DateTime?               @map("resolved_at")
  status         WeeklyRestrictionStatus @default(PENDENTE)
  impactsProgram Boolean                 @default(true) @map("impacts_program")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  program       WeeklyProgram               @relation(fields: [programId], references: [id], onDelete: Cascade)
  type          RestrictionType?            @relation(fields: [typeId], references: [id], onDelete: SetNull)
  activityLinks WeeklyRestrictionActivity[]

  @@index([programId])
  @@map("weekly_restrictions")
}

model WeeklyRestrictionActivity {
  restrictionId String @map("restriction_id")
  activityId    String @map("activity_id")

  restriction WeeklyRestriction @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  activity    WeeklyActivity    @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([restrictionId, activityId])
  @@map("weekly_restriction_activities")
}

model WeeklySnapshot {
  id          String             @id @default(uuid())
  programId   String             @map("program_id")
  kind        WeeklySnapshotKind
  payload     Json
  createdById String             @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")

  program   WeeklyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])

  @@index([programId, createdAt])
  @@map("weekly_snapshots")
}

model Upload {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  floorId    String?  @map("floor_id")
  fileName   String   @map("file_name")
  fileType   String   @map("file_type")
  category   String
  storageKey String   @map("storage_key")
  fileSize   Int      @map("file_size")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floor   Floor?  @relation(fields: [floorId], references: [id], onDelete: SetNull)

  @@index([projectId, category])
  @@index([floorId])
  @@map("uploads")
}
